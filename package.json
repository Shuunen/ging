{
  "$schema": "https://json.schemastore.org/package",
  "author": "Romain Racamier-Lafon <romain.racamier@gmail.com>",
  "bugs": "https://github.com/Shuunen/ging/issues",
  "dependencies": {
    "@auth0/auth0-vue": "~2.11.0",
    "@mdi/font": "~7.4.47",
    "@morev/vue-transitions": "~3.0.5",
    "@octokit/types": "~18.0.0",
    "@simolation/vue-hotkey": "~2.1.2",
    "@tailwindcss/postcss": "~4.3.3",
    "@tailwindcss/vite": "~4.3.3",
    "register-service-worker": "~1.7.2",
    "shuutils": "~11.0.0",
    "tailwindcss": "~4.3.3",
    "vue": "~3.5.43",
    "vuetify": "~4.2.2",
    "webfontloader": "~1.6.28"
  },
  "description": "GING Is Not Gantt, but kind of :)",
  "devDependencies": {
    "@types/node": "~26.6.3",
    "@types/webfontloader": "~1.6.38",
    "@vitejs/plugin-vue": "~6.0.9",
    "@vitest/coverage-v8": "~5.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "repo-check": "~1.46.0",
    "typescript": "~7.0.2",
    "unplugin-vue-components": "~32.1.0",
    "vite": "~8.3.1",
    "vite-plugin-vuetify": "~2.1.3",
    "vitest": "~5.0.2"
  },
  "files": [
    "src"
  ],
  "homepage": "https://github.com/Shuunen/ging",
  "keywords": [
    "webapp",
    "gantt",
    "plan"
  ],
  "license": "GPL-3.0",
  "name": "@shuunen/ging",
  "packageManager": "pnpm@12.8.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shuunen/ging.git"
  },
  "scripts": {
    "build": "pnpm build:vue && pnpm mark:html && pnpm mark:js && echo build success",
    "build:vue": "vite build",
    "check": "pnpm i && echo install success && pnpm lint && pnpm build && pnpm test && echo check success",
    "dev": "vite",
    "lint": "repo-check && pnpm lint:types && pnpm lint:format && pnpm lint:issues && echo lint success",
    "lint:format": "oxfmt --check && echo lint:format success || (echo Please run pnpm lint:format:fix && exit 1)",
    "lint:format:fix": "oxfmt --write && echo lint:format:fix success",
    "lint:issues": "oxlint --type-aware --deny-warnings --report-unused-disable-directives && echo lint:issues success || (echo Please run pnpm lint:issues:fix && exit 1)",
    "lint:issues:fix": "oxlint --fix --fix-suggestions --type-aware --deny-warnings --report-unused-disable-directives && echo lint:issues:fix success",
    "lint:types": "tsc --noEmit && echo lint:types success",
    "mark:html": "unique-mark dist/index.{html}",
    "mark:js": "unique-mark dist/assets/*.{js}",
    "postversion": "git push && git push --tags",
    "preversion": "pnpm check",
    "test": "vitest --run --coverage && echo test success",
    "test:update": "vitest --run --update && echo test update success",
    "test:watch": "vitest --coverage"
  },
  "type": "module",
  "version": "0.5.0"
}
